HOST=0.0.0.0
STRAPI_PORT=1337
API_PORT=1338
URL=http://localhost:1337
ALLOWED_ORIGINS=http://localhost:5173

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEYS_PATH=./encryption_keys.json

# Prompt panel: lmstudio (default), openai or anthropic
LLM_PROVIDER=lmstudio
# Use host.docker.internal instead of 127.0.0.1 when NAKAR runs in Docker.
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Optional for LM Studio: otherwise the first model from /v1/models is used.
# LLM_MODEL=qwen/qwen2.5-coder-14b
# LLM_API_KEY=

# Generation timeout in milliseconds, including reasoning (default: 5 minutes).
LLM_TIMEOUT_MS=300000
