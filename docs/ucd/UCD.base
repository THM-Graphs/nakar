formulas:
  Untitled: file.folder.split("/").slice(-2).join(" → ")
properties:
  formula.Untitled:
    displayName: Epic
  note.Description:
    displayName: Description
views:
  - type: table
    name: User Stories
    filters:
      and:
        - Hidden != true
        - file.inFolder(this.file.folder + "/User Stories")
    groupBy:
      property: formula.Untitled
      direction: ASC
    order:
      - file.name
      - Priority
      - Implemented
      - Description
      - Notes
      - Roles
    sort:
      - property: Priority
        direction: DESC
      - property: file.ctime
        direction: DESC
      - property: file.folder
        direction: ASC
      - property: Epic
        direction: ASC
    columnSize:
      note.description: 1136
      note.Notes: 337
    cardSize: 280
    imageAspectRatio: 1
    markers: number
    indentProperties: false
    rowHeight: medium
  - type: table
    name: Personas
    filters:
      and:
        - file.inFolder(this.file.folder + "/Personas")
    order:
      - file.name
      - Common roles
      - Tasks
      - Needs
    columnSize:
      note.Common roles: 380
      note.Tasks: 419
  - type: table
    name: Roles
    filters:
      and:
        - file.inFolder(this.file.folder + "/Roles")
  - type: table
    name: Unimplemented User Stories
    filters:
      and:
        - file.inFolder(this.file.folder + "/User Stories")
        - Implemented == false
        - Hidden != true
    groupBy:
      property: formula.Untitled
      direction: ASC
    order:
      - file.name
      - Implemented
      - Priority
      - Description
      - Notes
    sort:
      - property: Priority
        direction: DESC
    columnSize:
      file.name: 348
      note.Implemented: 124
      note.Priority: 103
      note.description: 1136
      note.Notes: 445
    rowHeight: medium
